# Rok Šped Plus — production Apache config

Options -Indexes -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Addresses of the previous site that Google still crawls (Search Console, 26.11.2026):
  # one permanent hop to the matching page, before the HTTPS/www rule
  RewriteRule ^(about|clients)/?$ https://www.roksped.rs/o-nama [NC,R=301,L]
  RewriteRule ^contact/?$ https://www.roksped.rs/kontakt [NC,R=301,L]
  RewriteRule ^(services|transport|logistika|carinsko-posredovanje)/?$ https://www.roksped.rs/usluge [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://www.roksped.rs/ [R=301,L]

  # Force HTTPS and the canonical www host
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^roksped\.rs$ [NC]
  RewriteRule ^(.*)$ https://www.roksped.rs/$1 [L,R=301]

  # Serve a prerendered route's index.html for its clean path (no trailing-slash redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  # Every real route is prerendered (scripts/prerender.mjs), so anything else is not a page:
  # no SPA fallback here, the ErrorDocument below answers with a real 404.
</IfModule>

# Unknown paths: status 404 for Google (no soft 404), body is the app, which renders NotFoundPage (noindex)
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-XSS-Protection "1; mode=block"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Never serve the deployed backend/config source directly from this document root
<FilesMatch "\.(env|log|md)$">
  Require all denied
</FilesMatch>
